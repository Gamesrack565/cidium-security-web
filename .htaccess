RewriteEngine On

# /politica-de-privacidad → /politica-de-privacidad.html
RewriteRule ^politica-de-privacidad$ politica-de-privacidad.html [L]

DirectoryIndex index.html index.php

RewriteRule ^politica-de-privacidad$ politica-de-privacidad.html [L]

RewriteEngine On

RewriteCond %{THE_REQUEST} \s/+index\.html(?:\?|\s) [NC]
RewriteRule ^index\.html$ / [R=301,L]

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [R=404,L]
</IfModule>

ExpiresByType text/html "access plus 5 minutes"

<IfModule mod_headers.c>

    # Evitar MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Evitar que Cidium sea embebido en iframes externos
    Header always set X-Frame-Options "DENY"

    # Limitar información enviada en Referer
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # APIs del navegador que esta landing no utiliza
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # HSTS inicial
    Header always set Strict-Transport-Security "max-age=604800"

</IfModule>